   
class LowMemoryTrendEngine {
    // Zero arrays! Just simple numeric registers.
    private var _smoothedPower = 0.0;
    private var _smoothedHR = 0.0;
    private var _smoothedTQ = 0.0;
    private var _samplesCount = 0;

    function updateMetricsLowMem(rawPower, rawHR, rawTorque, targetWindowSec) {
        if (_samplesCount < targetWindowSec) {
            _samplesCount++;
        }

        // Use an Exponential Moving Average (EMA) alpha weight
        // This mirrors a rolling window perfectly with ZERO array storage overhead!
        var alpha = 2.0 / (_samplesCount + 1.0);

        _smoothedPower = (_smoothedPower * (1.0 - alpha)) + ((rawPower != null ? rawPower : 0) * alpha);
        _smoothedHR    = (_smoothedHR * (1.0 - alpha)) + ((rawHR != null ? rawHR : 0) * alpha);
        _smoothedTQ    = (_smoothedTQ * (1.0 - alpha)) + ((rawTorque != null ? rawTorque : 0.0) * alpha);

        // Your outputs are immediately ready and perfectly smooth
        actualPower = _smoothedPower;
        actualHR    = _smoothedHR;
        actualTQ    = _smoothedTQ;
        actualEF    = actualHR > 0 ? actualPower / actualHR : 0.0;
    }
}


